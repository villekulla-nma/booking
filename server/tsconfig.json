{
  "compileOnSave": true,
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../dist/api",
    "target": "es2022",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "esModuleInterop": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "inlineSources": true,
    "pretty": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": [
    "tsdown.config.ts",
    "migrations",
    "models",
    "seeders",
    "src",
    "tests"
  ]
}
