{
  "name": "@booking/server",
  "version": "0.7.1",
  "author": "Emanuel Kluge (https://emanuel-kluge.de/)",
  "license": "MIT",
  "scripts": {
    "db:seed": "node --env-file=\"../.env\" ../node_modules/.bin/sequelize-cli db:seed:all",
    "db:migrate": "node --env-file=\"../.env\" ../node_modules/.bin/sequelize-cli db:migrate",
    "predev": "rm -f ./db_dev.sqlite && npm run db:migrate -- --debug && npm run db:seed -- --debug",
    "dev": "node --enable-source-maps --env-file=\"../.env\" --watch-path=\"./src\" ../node_modules/.bin/ts-node ./src",
    "lint": "eslint .",
    "test:watch": "jest --watch",
    "test": "jest",
    "build": "ncc build src/index.ts -o ../dist/api --target es2020",
    "gen-salt": "node -e \"console.log(require('bcryptjs').genSaltSync())\"",
    "create-id": "node -e \"console.log(require('shortid').generate())\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/helpers/"
    ]
  },
  "dependencies": {
    "@sendgrid/mail": "8.1.4",
    "bcryptjs": "2.4.3",
    "fastify": "4.28.1",
    "fluent-json-schema": "5.0.0",
    "jsonwebtoken": "9.0.2",
    "randomcolor": "0.6.2",
    "sequelize": "6.37.5",
    "shortid": "2.2.17",
    "sqlite3": "5.1.7"
  },
  "devDependencies": {
    "@booking/types": "0.7.1",
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.13.2",
    "@types/randomcolor": "0.5.9",
    "@types/shortid": "2.2.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vercel/ncc": "0.38.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.3",
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0",
    "sequelize-cli": "6.6.2",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
