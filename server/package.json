{
  "name": "@booking/server",
  "version": "0.7.7",
  "author": "Emanuel Kluge (https://emanuel-kluge.de/)",
  "license": "MIT",
  "scripts": {
    "db:seed": "node --env-file=\"../.env\" ../node_modules/.bin/sequelize-cli db:seed:all",
    "db:migrate": "node --env-file=\"../.env\" ../node_modules/.bin/sequelize-cli db:migrate",
    "predev": "rm -f ./db_dev.sqlite && npm run db:migrate -- --debug && npm run db:seed -- --debug",
    "dev": "node --enable-source-maps --env-file=\"../.env\" --watch-path=\"./src\" ../node_modules/.bin/ts-node ./src",
    "lint": "eslint .",
    "test:watch": "jest --watch",
    "test": "jest",
    "build": "tsdown",
    "gen-salt": "node -e \"console.log(require('bcryptjs').genSaltSync(12))\"",
    "create-id": "node -e \"console.log(require('shortid').generate())\""
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "clearMocks": true,
    "testMatch": [
      "**/tests/*.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/helpers/"
    ]
  },
  "dependencies": {
    "@sendgrid/mail": "8.1.5",
    "bcryptjs": "3.0.2",
    "fastify": "5.4.0",
    "fluent-json-schema": "6.0.0",
    "jsonwebtoken": "9.0.2",
    "randomcolor": "0.6.2",
    "sequelize": "6.37.7",
    "shortid": "2.2.17",
    "sqlite3": "5.1.7"
  },
  "devDependencies": {
    "@booking/types": "0.7.2",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.18.0",
    "@types/randomcolor": "0.5.9",
    "@types/shortid": "2.2.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "29.7.0",
    "jest-environment-node": "30.0.5",
    "sequelize-cli": "6.6.3",
    "ts-jest": "29.1.1",
    "ts-node": "10.9.2",
    "tsdown": "0.13.3",
    "typescript": "5.9.2"
  }
}
