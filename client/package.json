{
  "name": "@booking/client",
  "version": "0.7.7",
  "author": "Emanuel Kluge (https://emanuel-kluge.de/)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && NODE_ENV=production vite build",
    "prelint": "tsc --noEmit",
    "lint": "eslint --no-ignore src",
    "test:watch": "vitest watch",
    "test": "CI=true NODE_OPTIONS=\"--disable-warning=DEP0040\" vitest"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "react",
      "jsx-a11y",
      "react-hooks"
    ],
    "env": {
      "browser": true,
      "es6": true,
      "node": true
    },
    "parserOptions": {
      "sourceType": "module"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "overrides": [
      {
        "files": [
          "src/**/__tests__/*.ts?(x)"
        ],
        "plugins": [
          "testing-library"
        ]
      }
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "dependencies": {
    "@fluentui/merge-styles": "8.6.14",
    "@fluentui/react": "8.123.0",
    "@fluentui/theme": "2.6.67",
    "@fluentui/utilities": "8.15.22",
    "@fullcalendar/core": "6.1.17",
    "@fullcalendar/daygrid": "6.1.17",
    "@fullcalendar/interaction": "6.1.17",
    "@fullcalendar/react": "6.1.17",
    "@fullcalendar/timegrid": "6.1.17",
    "@uifabric/icons": "7.9.6",
    "classnames": "2.5.1",
    "date-fns": "4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "6.0.0",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@booking/types": "0.7.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.21",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react-swc": "4.2.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-testing-library": "7.13.5",
    "jsdom": "26.1.0",
    "nock": "14.0.16",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "3.2.6"
  }
}
